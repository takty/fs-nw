{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": ["node"],
		"strict": true,
		"declaration": true,
		"emitDeclarationOnly": true,
		"noEmitOnError": true,
		"rootDir": "src",
		"outDir": "dist"
	},
	"include": ["src/fs-base.ts", "src/fs-node.ts", "src/fs-web.ts"]
}
